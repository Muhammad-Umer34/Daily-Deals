{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "start"],
      "env": { "PORT": "5000" },
      "autoPort": false,
      "port": 5000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "chatbot",
      "runtimeExecutable": "chatbot/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "chatbot", "main:app", "--port", "8001"],
      "autoPort": false,
      "port": 8001
    }
  ]
}
